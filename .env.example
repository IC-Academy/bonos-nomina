# Copiar a .env.local (ignorado por git). Sólo valores públicos: todo termina en el bundle del navegador.
# demo = datos ficticios en memoria | api = backend productivo (hoy sin endpoints: muestra "Integración pendiente")
VITE_DATA_MODE=demo
# URL base del backend cuando exista (p. ej. webhook de n8n detrás de Entra ID). No poner secretos aquí.
VITE_API_BASE_URL=
